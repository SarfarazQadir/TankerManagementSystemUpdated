@model TankerManagementSystem.Models.AtsPsoEntry

@{
    ViewData["Title"] = "Edit ATS PSO Entry";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="card">
            <div class="card-header">
                <h4>Edit ATS PSO Entry</h4>
            </div>

            <div class="card-body">
                <form method="post" asp-action="Edit" onsubmit="return validateEditAtsForm(event)">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-group">
                        <label>Select Date <span style="color:red;">*</span></label>
                        <input type="date" id="EntryDate" asp-for="EntryDate" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Tanker <span style="color:red;">*</span></label>
                        <select id="TankerId" asp-for="TankerId" class="form-control" asp-items="@(new SelectList(ViewBag.Tankers, "Value", "Text"))">
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Debit Amount (PKR) <span style="color:red;">*</span></label>
                        <input type="number" step="0.01" id="Amount" asp-for="Amount" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Description / Details <span style="color:red;">*</span></label>
                        <textarea id="Description" asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="text-center">
                        <input type="submit" value="Update Record" class="btn btn-primary" />
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function validateEditAtsForm(event) {
        let tankerId = document.getElementById("TankerId").value.trim();
        let amount = document.getElementById("Amount").value.trim();
        let description = document.getElementById("Description").value.trim();
        let entryDate = document.getElementById("EntryDate").value.trim();

        if (entryDate === "") {
            iziToast.error({ title: 'Error', message: 'Please select a Date!', position: 'bottomRight' });
            event.preventDefault(); return false;
        }
        if (tankerId === "") {
            iziToast.error({ title: 'Error', message: 'Tanker selection is required!', position: 'bottomRight' });
            event.preventDefault(); return false;
        }
        if (amount === "" || isNaN(amount) || parseFloat(amount) <= 0) {
            iziToast.error({ title: 'Error', message: 'Amount must be valid!', position: 'bottomRight' });
            event.preventDefault(); return false;
        }
        if (description === "") {
            iziToast.error({ title: 'Error', message: 'Description cannot be empty!', position: 'bottomRight' });
            event.preventDefault(); return false;
        }
        return true;
    }
</script>