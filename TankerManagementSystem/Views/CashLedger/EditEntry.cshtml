@model TankerManagementSystem.Models.CashLedger

@{
    ViewData["Title"] = "EditEntry";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4>Edit Cash Entry</h4>
        </div>

        <div class="card-body">
            <form method="post" action="@Url.Action("EditEntry")" onsubmit="return validateEditCashLedgerForm(event)">

                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" />
                <input type="hidden" name="CreatedBy" value="@Model.CreatedBy" />
                <input type="hidden" name="PersonId" value="@Model.PersonId" />

                <div class="form-group">
                    <label>Date<span style="color:red;">*</span></label>
                    <input type="date"
                           id="EntryDate"
                           name="EntryDate"
                           value="@Model.EntryDate.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Link to Tanker (Optional)</label>
                    <select id="TankerId" name="TankerId" class="form-control select2">
                        <option value="">-- Select Tanker (If Applicable) --</option>
                        @if (ViewBag.Tankers != null)
                        {
                            foreach (var tanker in ViewBag.Tankers)
                            {
                                if (Model.TankerId == tanker.Id)
                                {
                                    <option value="@tanker.Id" selected="selected">@tanker.TankerNo</option>
                                }
                                else
                                {
                                    <option value="@tanker.Id">@tanker.TankerNo</option>
                                }
                            }
                        }
                    </select>
                    <small class="form-text text-muted">Modify vehicle profile mapping context dynamically if required.</small>
                </div>

                <div class="form-group">
                    <label>Link to Khata Person (Optional)</label>
                    <select id="KhataPersonId" name="KhataPersonId" class="form-control select2">
                        <option value="">-- Select Khata Person (If Applicable) --</option>
                        @if (ViewBag.Khatas != null)
                        {
                            foreach (var khata in ViewBag.Khatas)
                            {
                                if (Model.KhataPersonId == khata.Id)
                                {
                                    <option value="@khata.Id" selected="selected">@khata.Name</option>
                                }
                                else
                                {
                                    <option value="@khata.Id">@khata.Name</option>
                                }
                            }
                        }
                    </select>
                    <small class="form-text text-muted">Modify khata person mapping context dynamically if required.</small>
                </div>


                <div class="form-group">
                    <label>Description<span style="color:red;">*</span></label>
                    <textarea id="Description"
                              name="Description"
                              class="form-control">@Model.Description</textarea>
                </div>

                <div class="form-group">
                    <label style="color:green;">Credit</label>
                    <input type="number"
                           step="0.01"
                           id="Credit"
                           name="Credit"
                           value="@Model.Credit"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label style="color:red;">Debit</label>
                    <input type="number"
                           step="0.01"
                           id="Debit"
                           name="Debit"
                           value="@Model.Debit"
                           class="form-control" />
                </div>

                <div class="form-group form-check">
                    <input type="checkbox"
                           id="IsGeneralExpense"
                           name="IsGeneralExpense"
                           class="form-check-input"
                           value="true"
                           checked="@(Model.IsGeneralExpense ? "checked" : null)" />
                    <label class="form-check-label" for="IsGeneralExpense">
                        This is a general company expense (Office rent, salaries, utilities, etc.)
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">Update Entry</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
            </form>
        </div>
    </div>
</section>

<script>
    function validateEditCashLedgerForm(event) {
        let entryDate = document.getElementById("EntryDate").value.trim();
        let description = document.getElementById("Description").value.trim();
        let credit = document.getElementById("Credit").value.trim();
        let debit = document.getElementById("Debit").value.trim();

        if (entryDate === "") {
            iziToast.error({ title: 'Error', message: 'Date is required!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        if (description === "") {
            iziToast.error({ title: 'Error', message: 'Description is required!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        if (credit === "" && debit === "") {
            iziToast.error({ title: 'Error', message: 'Please enter Credit or Debit amount!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        return true;
    }

    @if (TempData["success"] != null)
    {
            <text>
                iziToast.success({ title: 'Success', message: '@TempData["success"]', position: 'bottomRight' });
            </text>
    }

    @if (TempData["error"] != null)
    {
            <text>
                iziToast.error({ title: 'Error', message: '@TempData["error"]', position: 'bottomRight' });
            </text>
    }
</script>
