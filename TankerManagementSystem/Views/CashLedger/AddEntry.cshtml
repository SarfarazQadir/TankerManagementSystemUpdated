@model TankerManagementSystem.Models.CashLedger

@{
    ViewData["Title"] = "AddEntry";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4>Add Cash Entry</h4>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("AddEntry")" onsubmit="return validateCashLedgerForm(event)">

                <div class="form-group">
                    <label>Date<span style="color:red;">*</span></label>
                    <input type="date" id="EntryDate" name="EntryDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label>Link to Tanker (Optional)</label>
                    <select id="TankerId" name="TankerId" class="form-control select2">
                        <option value="">-- Select Tanker (If Applicable) --</option>
                        @if (ViewBag.Tankers != null)
                        {
                            foreach (var tanker in ViewBag.Tankers)
                            {
                                <option value="@tanker.Id">@tanker.TankerNo</option>
                            }
                        }
                    </select>
                    <small class="form-text text-muted">Select a tanker to automatically update its corporate ledger balance.</small>
                </div>
                <div class="form-group">
                    <label>Link to Khata Person (Optional)</label>
                    <select id="KhataPersonId" name="KhataPersonId" class="form-control select2">
                        <option value="">-- Select Khata Person (If Applicable) --</option>
                        @if (ViewBag.Khatas != null)
                        {
                            foreach (var khata in ViewBag.Khatas)
                            {
                                <option value="@khata.Id">@khata.Name</option>
                            }
                        }
                    </select>
                    <small class="form-text text-muted">Select a person to automatically update their personal khata balance.</small>
                </div>

                <div class="form-group">
                    <label>Description<span style="color:red;">*</span></label>
                    <textarea id="Description" name="Description" class="form-control" placeholder="Enter transaction details..."></textarea>
                </div>

                <div class="form-group">
                    <label style="color:green;">Credit (Cash Inflow)</label>
                    <input type="number" step="0.01" id="Credit" name="Credit" class="form-control" placeholder="0.00" />
                </div>

                <div class="form-group">
                    <label style="color:red;">Debit (Cash Outflow / Given to Driver)</label>
                    <input type="number" step="0.01" id="Debit" name="Debit" class="form-control" placeholder="0.00" />
                </div>

                <div class="form-group form-check">
                    <input type="checkbox" id="IsGeneralExpense" name="IsGeneralExpense" class="form-check-input" value="true" />
                    <label class="form-check-label" for="IsGeneralExpense">
                        This is a general company expense (Office rent, salaries, utilities, etc.)
                    </label>
                    <small class="form-text text-muted">
                        Check this only if it's a genuine company-level expense — not linked to a specific Tanker or Khata Person.
                        This is what feeds the Dashboard's "Total Expenses" figure.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">Save Entry</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
            </form>
        </div>
    </div>
</section>

<script>
    function validateCashLedgerForm(event) {
        let entryDate = document.getElementById("EntryDate").value.trim();
        let description = document.getElementById("Description").value.trim();
        let credit = document.getElementById("Credit").value.trim();
        let debit = document.getElementById("Debit").value.trim();

        if (entryDate === "") {
            iziToast.error({ title: 'Error', message: 'Date is required!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        if (description === "") {
            iziToast.error({ title: 'Error', message: 'Description is required!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        if (credit === "" && debit === "") {
            iziToast.error({ title: 'Error', message: 'Please enter Credit or Debit amount!', position: 'bottomRight' });
            event.preventDefault();
            return false;
        }

        return true;
    }

    @if (TempData["success"] != null)
    {
            <text>
                iziToast.success({ title: 'Success', message: '@TempData["success"]', position: 'bottomRight' });
            </text>
    }
    @if (TempData["error"] != null)
    {
            <text>
                iziToast.error({ title: 'Error', message: '@TempData["error"]', position: 'bottomRight' });
            </text>
    }
</script>