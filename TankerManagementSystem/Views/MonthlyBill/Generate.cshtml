                    نوٹ : - اگر بل میں کسی قسم کی شکایت ہو تو 15 دن کے اندر ہم سے رجوع کریں ورنہ بعد میں کسی قسم کی شکایت قابل قبول نہیں ہو گی۔
                </p>
                <br><br><br>
                <div style="text-align: center;">
                    <span style="border-top: 1px solid #000; padding-top: 5px; width: 200px; display: inline-block;">Manager Signature</span>
                </div>
            </div>

            <div>
                <table class="ledger-table">
                    <tr>
                        <td>Total Freight <span class="arabic-text">کرایہ</span></td>
                        <td class="text-right" style="font-weight: bold;">@string.Format("{0:N0}", totalFreight)</td>
                    </tr>
                    <tr>
                        <td>Commission <span class="arabic-text">کمیشن</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalCommission)</td>
                    </tr>
                    <tr style="background: #f9f9f9; font-weight: bold;">
                        <td>Balance <span class="arabic-text">بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", balanceAfterCommission)</td>
                    </tr>
                    <tr>
                        <td>Total Shortage <span class="arabic-text">شارٹیج</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalShortage)</td>
                    </tr>
                    <tr>
                        <td>Advance <span class="arabic-text">ایڈوانس</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalAdvance)</td>
                    </tr>
                    <tr style="background: #f5f5f5; font-weight: bold;">
                        <td>Monthly Balance / Income <span class="arabic-text">آمدنی بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", monthlyIncomeBeforeExpenses)</td>
                    </tr>
                    <tr>
                        <td>Other Advance <span class="arabic-text">دیگر اخراجات</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalOtherAdvances)</td>
                    </tr>
                    <tr style="background: #e9e9e9; font-weight: bold;">
                        <td>Net Balance <span class="arabic-text">نیٹ بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", netMonthEndBalance)</td>
                    </tr>
                    <tr>
                        <td style="color: red;">Previous Balance <span class="arabic-text">سابقہ قرضہ</span></td>
                        <td style="color: red;" class="text-right">@string.Format("{0:N0}", previousBalance)</td>
                    </tr>
                    <tr style="background: #222; color: #fff; font-weight: bold; font-size: 16px;">
                        <td>Total Balance of @monthName-@ViewBag.Year<span class="arabic-text" style="color:#fff;">موجودہ قرضہ</span></td>
                        <td class="text-right">@string.Format("{0:N0}", totalBalance)</td>
                    </tr>
                </table>
            </div>
        </div>

    </div>
</body>
</html> *@
@model IEnumerable<TankerManagementSystem.Models.ViewModels.StatementRowVM>

@{
    Layout = null;
    var tanker = ViewBag.Tanker;

    decimal totalFreight = ViewBag.TotalFreight;
    decimal totalAdvance = ViewBag.TotalAdvance;
    decimal totalShortage = ViewBag.TotalShortage;
    decimal totalShortageLitre = ViewBag.TotalShortageLitre;
    decimal totalCommission = ViewBag.TotalCommission;
    decimal totalAts = ViewBag.TotalAts ?? 0;
    decimal totalCashCredit = ViewBag.TotalCashCredit;
    decimal totalCashDebit = ViewBag.TotalCashDebit;

    // STEP 1: Freight minus Commission = Balance
    decimal balanceAfterCommission = totalFreight - totalCommission;

    // STEP 2: Balance minus Shortage and Trip Advance = Monthly Balance / Income
    decimal monthlyIncomeBeforeExpenses = balanceAfterCommission - totalShortage - totalAdvance;

    // STEP 3: Grid Data sum for Other Advances (Cash Debit + ATS deductions, minus Cash Credit)
    // FIX: totalCashCredit was missing here before — any cash paid IN to the owner's
    // favor (Credit rows) was never offsetting Debit/ATS deductions, which understated
    // the month's true balance and could flip an actual profit into a displayed loss.
    decimal totalOtherAdvances = totalCashDebit + totalAts - totalCashCredit;

    // STEP 4: Monthly Balance/Income minus Other Advances = Current Net Month End Balance
    // With the fix above, this now matches the controller's netMovement calculation exactly.
    decimal netMonthEndBalance = monthlyIncomeBeforeExpenses - totalOtherAdvances;

    // STEP 5: Final Total Balance
    // FIX: previously this branched add/subtract based on the sign of previousBalance,
    // which was a workaround that only partially compensated for the missing-credit bug
    // above and produced wrong results in several cases. The correct, always-true formula
    // is simply previousBalance + netMovement — which is exactly what the controller
    // already computes and verifies against TankerLedger.RunningBalance. Using that
    // directly (ViewBag.ClosingBalance) keeps this view and the ledger as a single
    // source of truth instead of re-deriving the same number two different ways.
    decimal previousBalance = ViewBag.OpeningBalance ?? 0;
    decimal totalBalance = ViewBag.ClosingBalance ?? (previousBalance + netMonthEndBalance);

    // Profit vs Qarza (debt) — sign convention matches the rest of the app
    // (see Tanker Balance History page: negative = danger/red, zero or positive = success/green).
    bool isPreviousProfit = previousBalance >= 0;
    bool isTotalProfit = totalBalance >= 0;
    string previousUrduLabel = isPreviousProfit ? "منافع" : "قرضہ";
    string totalUrduLabel = isTotalProfit ? "منافع" : "قرضہ";

    string monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(ViewBag.Month);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Malik Brothers - Monthly Bill</title>

    <style>
            :root {
                --dark: #222;
                --theme-color: #86608E;
            }

            * {
                box-sizing: border-box;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            body {
                margin: 0;
                padding: 0;
                background: #e5e5e5;
                color: var(--dark);
            }

            .wrapper {
                max-width: 950px;
                margin: 20px auto;
                background: #ffffff;
                padding: 30px;
                border: 2px solid #000;
            }

            .bill-header {
                text-align: center;
                margin-bottom: 20px;
                border-bottom: 3px double #000;
                padding-bottom: 10px;
            }

                .bill-header h1 {
                    margin: 0;
                    font-size: 32px;
                    font-weight: bold;
                    text-transform: uppercase;
                }

                .bill-header h2 {
                    margin: 5px 0 0 0;
                    font-size: 18px;
                    font-weight: normal;
                }

            .meta-info-table {
                width: 100%;
                margin-bottom: 15px;
                font-size: 15px;
            }

            .section-title {
                background: #f0f0f0;
                border: 1px solid #000;
                padding: 6px 10px;
                font-weight: bold;
                font-size: 14px;
                margin-top: 20px;
                margin-bottom: 5px;
            }

            .arabic-text {
                font-family: sans-serif;
                direction: rtl;
                float: right;
                font-size: 14px;
                font-weight: bold;
            }

            table.data-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 15px;
                font-size: 14px;
            }

                table.data-table th, table.data-table td {
                    border: 1px solid #000;
                    padding: 8px;
                    text-align: center;
                }

                table.data-table th {
                    background: #f5f5f5;
                    font-weight: bold;
                }

            .text-left {
                text-align: left !important;
            }

            .text-right {
                text-align: right !important;
            }

            .ledger-container {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin-top: 25px;
            }

            table.ledger-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 14px;
            }

                table.ledger-table td {
                    border: 1px solid #000;
                    padding: 6px 10px;
                }

            .print-btn {
                text-align: center;
                margin: 20px;
            }

            .btn {
                background: var(--theme-color);
                color: #ffffff;
                border: none;
                padding: 12px 30px;
                cursor: pointer;
                border-radius: 30px;
                font-weight: bold;
                font-size: 14px;
            }

            @@media print {
                .print-btn {
                    display: none;
                }

                body {
                    background: #ffffff;
                }

                .wrapper {
                    border: none;
                    margin: 0;
                    padding: 0;
                }
            }
    </style>
</head>

<body>

    <div class="print-btn">
        <button class="btn" onclick="window.print()">PRINT MONTHLY STATEMENT</button>
    </div>

    <div class="wrapper">

        <div class="bill-header">
            <div style="float: left; font-weight: bold; font-size: 16px;">TMB-@tanker.Id</div>
            <div style="float: right; font-weight: bold; font-size: 16px;">@monthName-@ViewBag.Year</div>
            <div style="clear: both;"></div>
            <h1>MALIK BROTHERS</h1>
            <h2>TLS Monthly Bill PSO</h2>
        </div>

        <table class="meta-info-table">
            <tr>
                <td style="width: 15%;"><strong>Tanker No:</strong></td>
                <td style="width: 35%;">@tanker.TankerNo (@tanker.Capacity)</td>
                <td style="width: 15%;"><strong>Owner Name:</strong></td>
                <td style="width: 35%;">@tanker.Owner?.Name</td>
            </tr>
        </table>

        <div class="section-title">
            40-KL Trips Details (All Monthly Entries)
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Loading Date <br><span class="arabic-text">تاریخ</span></th>
                    <th>Destination / Route Details</th>
                    <th>Shortage Liter <br><span class="arabic-text">شارٹیج لیٹر</span></th>
                    <th>Shortage Amount <br><span class="arabic-text">شارٹیج رقم</span></th>
                    <th>Advance <br><span class="arabic-text">ایڈوانس</span></th>
                    <th>Freight <br><span class="arabic-text">کرایہ</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Where(x => x.RowType == "TRIP"))
                {
                    <tr>
                        <td>@row.Date.ToString("dd/MM/yyyy")</td>
                        <td class="text-left"><strong>@row.Details</strong></td>
                        <td class="text-right">@string.Format("{0:N0}", row.TripRef?.ShortageLiters ?? 0)</td>
                        <td class="text-right">@string.Format("{0:N0}", row.TripRef?.Shortage ?? 0)</td>
                        <td class="text-right">@string.Format("{0:N0}", row.TripRef?.AdvanceCash ?? 0)</td>
                        <td class="text-right">@string.Format("{0:N0}", row.Freight)</td>
                    </tr>
                }
                @if (!Model.Any(x => x.RowType == "TRIP"))
                {
                    <tr>
                        <td colspan="6" style="color: #999; padding: 15px;">Is mahine koi load nahi laga hai.</td>
                    </tr>
                }
                <tr style="font-weight: bold; background: #fafafa;">
                    <td colspan="2">Total Freight, Shortages and Advances</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalShortageLitre)</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalShortage)</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalAdvance)</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalFreight)</td>
                </tr>
            </tbody>
        </table>

        <div class="section-title">
            Details of Other Advances<span class="arabic-text">دیگر اخراجات </span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th colspan="2">Detail / Expenses Description <span class="arabic-text">تفصیل</span></th>
                    <th>DR (Debit / Deduction)</th>
                    <th>CR (Credit)</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @{
                    decimal runningBal = 0;
                }
                @foreach (var row in Model.Where(x => x.RowType == "CASH" || x.RowType == "ATS"))
                {
                    // FIX: was `runningBal += row.Deduction;` only — Credit (row.Freight
                    // holds Credit for CASH rows, 0 for ATS) was never subtracted, so this
                    // running total only ever grew, even when the owner was actually paid
                    // back via a credit entry. Net effect below matches the ledger's Net.
                    runningBal += row.Deduction - row.Freight;

                    // FIX: Description se [ATS PSO] ka prefix remove karne ka logic
                    string cleanDetails = row.Details ?? "";
                    if (cleanDetails.StartsWith("[ATS PSO] - "))
                    {
                        cleanDetails = cleanDetails.Replace("[ATS PSO] - ", "");
                    }

                    <tr>
                        <td>@row.Date.ToString("dd/MM/yyyy")</td>
                        <td class="text-left" colspan="2">@cleanDetails</td>
                        <td class="text-right">@string.Format("{0:N0}", row.Deduction)</td>
                        <td class="text-right">@(row.Freight > 0 ? string.Format("{0:N0}", row.Freight) : "-")</td>
                        <td class="text-right">@string.Format("{0:N0}", runningBal)</td>
                    </tr>
                }
                @if (!Model.Any(x => x.RowType == "CASH" || x.RowType == "ATS"))
                {
                    <tr>
                        <td colspan="6" style="color: #999; padding: 15px;">Is mahine koi expenses nahi hain.</td>
                    </tr>
                }
                <tr style="font-weight: bold; background: #fafafa;">
                    <td colspan="3">Total Other Deductions</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalCashDebit + totalAts)</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalCashCredit)</td>
                    <td class="text-right" style="color: red;">@string.Format("{0:N0}", totalCashDebit + totalAts)</td>
                </tr>
            </tbody>
        </table>

        <div class="ledger-container">
            <div style="margin-top: 40px; font-size: 12px; line-height: 1.5;">
                <p style="font-weight: bold;">
                    نوٹ : - اگر بل میں کسی قسم کی شکایت ہو تو 15 دن کے اندر ہم سے رجوع کریں ورنہ بعد میں کسی قسم کی شکایت قابل قبول نہیں ہو گی۔
                </p>
                <br><br><br>
                <div style="text-align: center;">
                    <span style="border-top: 1px solid #000; padding-top: 5px; width: 200px; display: inline-block;">Manager Signature</span>
                </div>
            </div>

            <div>
                <table class="ledger-table">
                    <tr>
                        <td>Total Freight <span class="arabic-text">کرایہ</span></td>
                        <td class="text-right" style="font-weight: bold;">@string.Format("{0:N0}", totalFreight)</td>
                    </tr>
                    <tr>
                        <td>Commission <span class="arabic-text">کمیشن</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalCommission)</td>
                    </tr>
                    <tr style="background: #f9f9f9; font-weight: bold;">
                        <td>Balance <span class="arabic-text">بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", balanceAfterCommission)</td>
                    </tr>
                    <tr>
                        <td>Total Shortage <span class="arabic-text">شارٹیج</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalShortage)</td>
                    </tr>
                    <tr>
                        <td>Advance <span class="arabic-text">ایڈوانس</span></td>
                        <td class="text-right" style="color: red;">- @string.Format("{0:N0}", totalAdvance)</td>
                    </tr>
                    <tr style="background: #f5f5f5; font-weight: bold;">
                        <td>Monthly Balance / Income <span class="arabic-text">آمدنی بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", monthlyIncomeBeforeExpenses)</td>
                    </tr>
                    <tr>
                        <td>Other Advance <span class="arabic-text">دیگر اخراجات</span></td>
                        <td class="text-right" style="color: @(totalOtherAdvances >= 0 ? "red" : "green");">
                            @(totalOtherAdvances >= 0 ? "-" : "+") @string.Format("{0:N0}", Math.Abs(totalOtherAdvances))
                        </td>
                    </tr>
                    <tr style="background: #e9e9e9; font-weight: bold;">
                        <td>Net Balance <span class="arabic-text">نیٹ بقایا</span></td>
                        <td class="text-right">@string.Format("{0:N0}", netMonthEndBalance)</td>
                    </tr>
                    <tr>
                        <td style="color: @(isPreviousProfit ? "green" : "red");">
                            Previous @(isPreviousProfit ? "Profit" : "Balance")
                            <span class="arabic-text">سابقہ @previousUrduLabel</span>
                        </td>
                        <td style="color: @(isPreviousProfit ? "green" : "red");" class="text-right">
                            @string.Format("{0:N0}", Math.Abs(previousBalance))
                        </td>
                    </tr>
                    <tr style="background: #222; color: #fff; font-weight: bold; font-size: 16px;">
                        <td>
                            Total @(isTotalProfit ? "Profit" : "Balance") of @monthName-@ViewBag.Year
                            <span class="arabic-text" style="color: @(isTotalProfit ? "#4caf50" : "#ff5252");">
                                موجودہ @totalUrduLabel
                            </span>
                        </td>
                        <td class="text-right" style="color: @(isTotalProfit ? "#4caf50" : "#ff5252");">
                            @string.Format("{0:N0}", Math.Abs(totalBalance))
                        </td>
                    </tr>
                </table>
            </div>
        </div>

    </div>
</body>
</html>
