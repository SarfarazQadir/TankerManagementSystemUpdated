@model IEnumerable<TankerManagementSystem.Models.TripLedger>

@{
    ViewData["Title"] = "Trip Transactions";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@if (TempData["add_ledger"] != null)
{
    <script>
        Swal.fire({
            title: '@TempData["add_ledger"]',
            icon: 'success'
        });
    </script>
}

@if (TempData["edit_ledger"] != null)
{
    <script>
        Swal.fire({
            title: '@TempData["edit_ledger"]',
            icon: 'success'
        });
    </script>
}

<section class="section">
    <div class="section-body">

        <br />
        <br />

        <div class="card">
            <div class="card-header">
                <h4>Trip Transaction Details</h4>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="myTable">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Id</th>
                                <th>Trip Entry Id</th>
                                <th>Token No</th>
                                <th>Trip From</th>
                                <th>Trip To</th>
                                <th>Product</th>
                                <th>Freight</th>
                                <th>Grand Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int i = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@item.Id</td>
                                    <td>@item.TripEntryId</td>

                                    <td>
                                        <span class="badge badge-light font-weight-bold">@item.TokenNo</span>
                                    </td>

                                    <td>@item.TripEntryFk?.FromLocation</td>

                                    <td>@item.TripEntryFk?.ToLocation</td>

                                    <td>@item.Product?.ProductName</td>

                                    <td class="font-weight-bold">
                                        @string.Format("{0:N0}", Math.Floor(item.Freight))
                                    </td>

                                    <td class="text-success font-weight-bold">
                                        @string.Format("{0:N0}", Math.Floor(item.GrandTotal))
                                    </td>

                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-warning dropdown-toggle" data-toggle="dropdown">
                                                Options
                                            </button>
                                            <div class="dropdown-menu">
                                                <a class="dropdown-item" href="@Url.Action("EditLedger", new { id = item.Id })">
                                                    Edit
                                                </a>
                                                <a class="dropdown-item" href="@Url.Action("PrintBill", new { id = item.Id })" target="_blank">
                                                    Print
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>