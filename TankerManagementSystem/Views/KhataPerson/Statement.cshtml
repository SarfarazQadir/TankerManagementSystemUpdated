@model List<TankerManagementSystem.Models.PersonalKhata>

@{
    ViewData["Title"] = "Statement";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
    var person = (TankerManagementSystem.Models.KhataPerson)ViewBag.Person;
}

<section class="section">
    <div class="section-body">

        <div class="card">
            <div class="card-header">
                <h4>Khata Statement — @person.Name</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">
                        <strong>Name:</strong> @person.Name
                    </div>
                    <div class="col-sm-3">
                        <strong>Contact:</strong> @person.ContactNumber
                    </div>
                    <div class="col-sm-3">
                        <strong>Address:</strong> @person.Address
                    </div>
                    <div class="col-sm-3">
                        <strong>Current Balance:</strong>
                        <span class="">
                            @Math.Floor(person.CurrentBalance)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <br />

        <div class="card">
            <div class="card-header">
                <h4>Ledger Entries</h4>
                <div class="card-header-action">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">

                    <table class="table table-striped table-bordered table-hover" id="myTable">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Entry Date</th>
                                <th>Description</th>
                                <th>Add Amount</th>
                                <th>Minus Amount</th>
                                <th>Balance</th>
                                <th>Module</th>
                                <th>Created By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int serialNumber = 1;
                            }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@serialNumber</td>
                                        <td>@item.EntryDate.ToString("dd/MMM/yyyy")</td>
                                        <td>@item.Description</td>
                                        <td class="text-success">@(item.AddAmount > 0 ? item.AddAmount.ToString("N2") : "-")</td>
                                        <td class="text-danger">@(item.MinusAmount > 0 ? item.MinusAmount.ToString("N2") : "-")</td>
                                        <td><strong>@item.Balance.ToString("N2")</strong></td>
                                        <td>@item.ModuleName</td>
                                        <td>@item.CreatedBy</td>
                                    </tr>
                                    serialNumber++;
                                }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-right">Total</th>
                                <th class="text-success">@Model.Sum(x => x.AddAmount).ToString("N2")</th>
                                <th class="text-danger">@Model.Sum(x => x.MinusAmount).ToString("N2")</th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>