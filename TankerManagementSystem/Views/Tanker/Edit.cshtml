@model TankerManagementSystem.Models.Tanker
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="card">
            <div class="card-header">
                <h4>Edit Tanker</h4>
            </div>
            <div class="card-body">
                <form method="post"
                      asp-action="Edit"
                      onsubmit="return validateTankerEditForm(event)">

                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label>
                            Tanker No <span style="color:red;">*</span>
                        </label>
                        <input asp-for="TankerNo"
                               id="TankerNo"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>
                            Select Owner <span style="color:red;">*</span>
                        </label>
                        <select asp-for="OwnerId"
                                id="OwnerId"
                                class="form-control">
                            <option value="">-- Select Owner --</option>
                            @foreach (var item in ViewBag.Owners)
                            {
                                <option value="@item.Id"
                                        selected="@(item.Id == Model.OwnerId)">
                                    @item.Id - @item.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>
                            Model <span style="color:red;">*</span>
                        </label>
                        <input asp-for="Model"
                               id="Model"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>
                            Capacity <span style="color:red;">*</span>
                        </label>
                        <input asp-for="Capacity"
                               id="Capacity"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>
                            Current Balance (PKR)
                            <!-- FIX Issue 10: CurrentBalance field made read-only - Done by AntiGravity on 2026-07-18 08:15 PST -->
                            <small class="text-muted">(Read-only — managed via ledger entries)</small>
                        </label>
                        <input type="text"
                               value="@Model.CurrentBalance.ToString("N2")"
                               class="form-control"
                               readonly
                               disabled
                               style="background-color: #f0f0f0; font-weight: bold;" />
                    </div>

                    <div class="text-center">
                        <input type="submit"
                               value="Update Tanker"
                               class="btn btn-primary" />
                        <a href="@Url.Action("Index")"
                           class="btn btn-secondary">
                            Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function validateTankerEditForm(event) {
        let tankerNo = document.getElementById("TankerNo").value.trim();
        let ownerId = document.getElementById("OwnerId").value.trim();
        let model = document.getElementById("Model").value.trim();
        let capacity = document.getElementById("Capacity").value.trim();

        if (tankerNo === "") {
            iziToast.error({
                title: 'Error',
                message: 'Tanker No is required!',
                position: 'bottomRight'
            });
            event.preventDefault();
            return false;
        }

        if (ownerId === "") {
            iziToast.error({
                title: 'Error',
                message: 'Please select Owner!',
                position: 'bottomRight'
            });
            event.preventDefault();
            return false;
        }

        if (model === "") {
            iziToast.error({
                title: 'Error',
                message: 'Model is required!',
                position: 'bottomRight'
            });
            event.preventDefault();
            return false;
        }

        if (capacity === "") {
            iziToast.error({
                title: 'Error',
                message: 'Capacity is required!',
                position: 'bottomRight'
            });
            event.preventDefault();
            return false;
        }

        return true;
    }
</script>